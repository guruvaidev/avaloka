# Build context MUST be the repository root:
#   docker build -f deploy/avaloka/charts/avaloka-backend/docker/Dockerfile.langgraph -t avaloka-langgraph:latest .
FROM python:3.11-slim
# Third-party usage beacons, and botocore's instance-metadata credential probe,
# off by default (app/core/thirdparty_optout.py says what each one silences:
# daft -> scarf.sh, onnxruntime -> events.data.microsoft.com, chroma, mlflow,
# HF hub, dvc, Ray usage stats, streamlit, langgraph-cli and its PyPI version check; 169.254.169.254). A deployment opts
# back in by setting the variable itself, e.g. AWS_EC2_METADATA_DISABLED=false
# to use the VM's instance credentials.
ENV DO_NOT_TRACK=true \
    SCARF_NO_ANALYTICS=true \
    ORT_DISABLE_TELEMETRY=1 \
    ANONYMIZED_TELEMETRY=False \
    MLFLOW_DISABLE_TELEMETRY=true \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DVC_NO_ANALYTICS=1 \
    RAY_USAGE_STATS_ENABLED=0 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    LANGGRAPH_CLI_NO_ANALYTICS=1 \
    LANGGRAPH_NO_VERSION_CHECK=true \
    AWS_EC2_METADATA_DISABLED=true

WORKDIR /app

# Build toolchain for packages without manylinux wheels (psycopg2, etc.).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install deps first so the layer caches across the api/langgraph images.
# requirements-langgraph-server.txt is requirements.txt plus langgraph-cli: the
# CLI is only for this image, because its langgraph-api caps cryptography <45.
COPY requirements.txt requirements-langgraph-server.txt /app/
RUN pip install --no-cache-dir -r requirements-langgraph-server.txt

COPY . /app

EXPOSE 3000

# `langgraph dev` serves the LangGraph runs API + /info + /docs. For a hardened
# production server, swap to the licensed `langgraph` runtime image; the chart
# and probes are unchanged.
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "3000"]
