# deploy/docker/Dockerfile.ray
# Ray worker/head image for avaloka: Ray runtime + avaloka compute deps + app code,
# so RayCluster nodes can run sampling/transform/training and the Serve app.
# Build context = repo root:  docker build -f deploy/docker/Dockerfile.ray -t avaloka-ray:latest .
#
# Pin the Ray base image to the Ray version compatible with the KubeRay operator
# installed by app/infra/ray_manager.py (KUBERAY_OPERATOR_VERSION=1.6.2). Ray
# token authentication (RAY_AUTH_MODE=token) needs Ray 2.52+ here and KubeRay
# 1.6+ there.
FROM rayproject/ray:2.56.0-py311
# Third-party usage beacons, and botocore's instance-metadata credential probe,
# off by default (app/core/thirdparty_optout.py says what each one silences:
# daft -> scarf.sh, onnxruntime -> events.data.microsoft.com, chroma, mlflow,
# HF hub, dvc, Ray usage stats, streamlit, langgraph-cli and its PyPI version check; 169.254.169.254). A deployment opts
# back in by setting the variable itself, e.g. AWS_EC2_METADATA_DISABLED=false
# to use the VM's instance credentials.
ENV DO_NOT_TRACK=true \
    SCARF_NO_ANALYTICS=true \
    ORT_DISABLE_TELEMETRY=1 \
    ANONYMIZED_TELEMETRY=False \
    MLFLOW_DISABLE_TELEMETRY=true \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DVC_NO_ANALYTICS=1 \
    RAY_USAGE_STATS_ENABLED=0 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    LANGGRAPH_CLI_NO_ANALYTICS=1 \
    LANGGRAPH_NO_VERSION_CHECK=true \
    AWS_EC2_METADATA_DISABLED=true

USER root

# The general RayCluster executes transformations and scheduled MTA training.
# Keep its Ray runtime aligned with the KubeRay RayCluster spec, and install the
# exact training environment used by the standalone training image.  The MTA
# entrypoint itself is copied below as part of ``COPY app ./app``.
COPY app/agents/mta_v2/training_docker_image/requirements.txt /tmp/mta-requirements.txt
RUN pip install --no-cache-dir -r /tmp/mta-requirements.txt tabulate

WORKDIR /home/ray/app
COPY app ./app
ENV PYTHONPATH=/home/ray/app
# Ray 2.52 turns Train V2 on by default (2.49 had it off). ray_job.py's
# TorchTrainer / train.report / Checkpoint flow was written and tested on V1;
# keep V1 until it is ported and run on a cluster. Ray propagates this
# variable from the driver to the train workers.
ENV RAY_TRAIN_V2_ENABLED=0

USER ray
