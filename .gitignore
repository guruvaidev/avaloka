
# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

.langgraph_api


# Virtual environment
agents-env/
.env
.bashrc

# Local developer env scripts — these export real secrets (API keys, service-role
# keys, service-account JSON) and must never be committed.
dev-env.bat
dev-env.sh
env_bak
*.env
# Per-developer overrides read by app/infra/deploy_stack.py before .env. Note
# "*.env" above only matches names ENDING in .env, so this needs its own entry.
.env.local
!.env.example
# scripts/quickstart.sh generates the laptop stack's secrets here on first run
# (DB_ENCRYPTION_KEY, the local-auth JWT secret and password, the Postgres
# password). "*.env" does not match it, so it needs its own entry.
.env.quickstart

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
agents-env/
env/
.venv/
.venv-langgraph-server/
venv/
venvt/

# VSCode settings
.vscode/

# Pytest cache
.pytest_cache/
.cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Output artifacts
*.log
*.out
*.err
*.tmp
*.bak

# Distribution / packaging
build/
dist/
*.egg-info/

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
desktop.ini

# IDE files
.idea/
*.iml

# Test artifacts
*.coverage
coverage.xml
htmlcov/

# Local development artifacts
prototype_v0.1/
*.csv
# ...but the /instant sample datasets are served from the UI's public assets.
!ui/public/samples/*.csv
# ...but bundled CLI example datasets must ship with the package.
!avaloka/examples/*.csv
# ...and so must the outcome map lookups (SHA256SUMS lists them; geo.py opens them).
!avaloka/outcomes/assets/*.csv
# ...and the published 1.6 traceability matrix (generated, public-safe; guarded by
# tests/release_1_6/test_traceability_public_safe.py).
!docs/test-reports/*.csv

# Optional:
# Logs
*.log
avaloka-agentic-workflow/artifacts/

# LangGraph local state
**/.langgraph_api/
data/

# for deployment
**/.chart.lock
**/.tgz

customers.json
models/
artifacts/
# MLflow artifacts
mlruns/
mlflow_runs/
mlflow.db
mlflow_ui.log

# Celery
*.rdb
artifacts/test_coder_integration/
rayjob.out.yaml
.kube
.ssh
.config

rag_docs/sysdocs_markdown/

# DTA local Docker runtime output
pipeline_runs/
.env
.env.backup
volumes/

# External benchmark checkouts and generated leaderboard artifacts
.benchmarks/
benchmarks/results/**
!benchmarks/results/.gitignore
!benchmarks/results/.gitkeep

# Internal engineering task spec — kept local, not part of the public repo
test_plan.md

start-avaloka.sh
gcp-service-account.json
ui/supabase/.temp/

# Cached public datasets fetched by tests/k8s/test_t7_agent_matrix.py
tests/fixtures/datasets/
# Kaggle datasets downloaded for benchmarks/tests
app/sample_data/

# Internal engineering task spec — kept local, not part of the public repo
test_plan.md

# Debug scripts belong under scripts/, reading keys from the environment.
/test.py
/test_milvus_integration.py

# Default output directories created by the avaloka CLI.
/avaloka-analysis/
/avaloka-model/
/avaloka-batch/
/avaloka-fleet/

# stray pip output committed by accident
2.2.0

# Run output — these were committed once and should not be again.
/artifacts/
/scorecard.json

# Internal product-planning notes from the UI builder; not documentation.
ui/.lovable/

# Local agent tooling configuration; not part of the product. Untracked by
# design. If the team decides to version it, remove this line and keep the
# oss/manifest.yaml exclusion in place, which is what stops it being published.
.claude/

# The format fixtures are committed on purpose; *.csv above would swallow them.
!tests/fixtures/formats/*.csv
!tests/fixtures/formats/sales_csv_parts/
!tests/fixtures/formats/sales_csv_parts/*.csv

# The null-word fixtures are committed on purpose; *.csv above would swallow them.
!tests/fixtures/null_words/*.csv

# The two-frame join fixtures are committed on purpose; *.csv above would swallow them.
!tests/fixtures/join_two_frames/*.csv

# Written beside .env while generated secrets are saved (app/core/provisioning.py).
.env.lock
.env.tmp

# The master test plan source is committed on purpose; *.csv above would swallow it.
!docs/test-plan/*.csv
# local DB backups and diagnostic output
backup_public_schema_*.sql
local_db_report.txt
