# Avaloka environment template.
#
# Copy to `.env` and fill in your own values. NEVER commit a real .env — it is
# .gitignore'd. Values shown as <...> are placeholders you must replace; the
# concrete defaults (localhost URLs, ports, booleans) work out of the box.

PYTHONPATH=.

# ====== Edition and deployment (optional; defaults shown) ======
# AVALOKA_DEPLOYMENT=self_hosted        # or avaloka_hosted
# AVALOKA_EDITION=oss                   # oss | professional | enterprise; ignored when a licence is present
# AVALOKA_LICENSE_KEY=<licence-token>   # overrides the stored licence file
# AVALOKA_HOME=~/.avaloka               # config directory
# AVALOKA_LICENSE_PUBLIC_KEY=<pem>      # staging only: override the verification key
# AVALOKA_ENV_FILE=.env                 # the file generated secrets are saved to
# AVALOKA_AUTO_PROVISION=1              # 0 = never generate secrets at service start

# ====== LLM keys (REQUIRED) — Groq Cloud (https://console.groq.com/) ======
# The planner and coder agents run on Groq Cloud for fast inference.
GROQ_API_KEY_PLANNING_AGENT=<groq-api-key-for-planning-agent>
GROQ_API_KEY_CODING_AGENT=<groq-api-key-for-coding-agent>
# avaloka_agent reuses GROQ_API_KEY_PLANNING_AGENT; falls back to GROQ_API_KEY if unset.

# ====== LLM backup (OPTIONAL) — OpenRouter (https://openrouter.ai/keys) ======
# Groq's token-per-minute limit is enforced per ORGANISATION, not per API key,
# so both GROQ_* keys above draw on one budget. When the Planner exhausts it the
# provider returns HTTP 429 and the user sees "I ran into a temporary problem
# while planning that request."
#
# Set this and the Planner retries those failures on OpenRouter instead. Also
# covers a model withdrawn from the account (404) and provider outages (5xx).
# Leave blank and nothing changes — the backup is entirely opt-in.
OPENROUTER_API_KEY=<openrouter-api-key-or-leave-blank>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AVALOKA_DISABLE_MODEL_FALLBACK=0     # 1 switches the backup off without deleting the key

# ====== Inference provider (custom-inference-stack) ======
# Which backend the AGENT LLMs use. Default "groq" keeps the Groq keys above and
# planner/agent behavior byte-identical. Set to run without Groq. Full contract:
# app/core/inference.py, deploy/inference/README.md.
#   groq (default) | local | openai | openrouter | bedrock | vertex | azure
# OpenRouter is the default: one key reaches many providers, including
# Groq itself. Set this to `groq` for the lowest-latency path.
INFERENCE_PROVIDER=openrouter
# Optional per-role overrides (PLANNING/CODING/VIZ); blank = inherit the above.
# INFERENCE_PROVIDER_PLANNING=groq
# INFERENCE_PROVIDER_CODING=local

# --- local: in-cluster OpenAI-spec model (kind/Ollama CPU, or vLLM GPU) ---
# INFERENCE_LOCAL_BASE_URL=http://avaloka-local-llm:11434/v1   # 8000 for vLLM
# INFERENCE_LOCAL_MODEL_LARGE=qwen3:4b-instruct-2507-q4_K_M   # served model id
# INFERENCE_LOCAL_MODEL_SMALL=qwen3:4b-instruct-2507-q4_K_M
# INFERENCE_LOCAL_API_KEY=sk-local                             # ignored by local servers

# --- openrouter ---
# OPENROUTER_API_KEY=<openrouter-key>
# INFERENCE_OPENROUTER_MODEL_LARGE=qwen/qwen-2.5-72b-instruct
# INFERENCE_OPENROUTER_MODEL_SMALL=qwen/qwen-2.5-7b-instruct

# --- openai (api.openai.com or any OpenAI-spec endpoint) ---
# Chat only: this key never turns on OpenAI embeddings (see EMBEDDING_PROVIDER).
# OPENAI_API_KEY=<openai-key>
# INFERENCE_OPENAI_BASE_URL=https://api.openai.com/v1
# INFERENCE_OPENAI_MODEL_LARGE=gpt-4o
# INFERENCE_OPENAI_MODEL_SMALL=gpt-4o-mini

# --- aws bedrock (creds via the standard AWS chain / IRSA) ---
# AWS_REGION=us-east-1
# INFERENCE_BEDROCK_MODEL_LARGE=meta.llama3-1-70b-instruct-v1:0
# INFERENCE_BEDROCK_MODEL_SMALL=meta.llama3-1-8b-instruct-v1:0

# --- gcp vertex ai (Application Default Credentials / Workload Identity) ---
# GOOGLE_CLOUD_PROJECT=<gcp-project>
# GOOGLE_CLOUD_LOCATION=us-central1
# INFERENCE_VERTEX_MODEL_LARGE=gemini-1.5-pro
# INFERENCE_VERTEX_MODEL_SMALL=gemini-1.5-flash

# --- azure openai / azure ai ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<azure-key>
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_LARGE=<large-deployment-name>
# AZURE_OPENAI_DEPLOYMENT_SMALL=<small-deployment-name>

# ====== Memory embeddings ======
# local (default): the bundled sentence-transformer; nothing leaves the host.
# openai: sends memory text -- user queries, learned hints, answers, and cached
# schema JSON with table and column names and sample values -- to OpenAI.
# It needs BOTH lines below; OPENAI_API_KEY above is never used for this.
EMBEDDING_PROVIDER=local
# EMBEDDING_OPENAI_API_KEY=<openai-key>

# ====== Redis (sessions/cache) ======
REDIS_URL=redis://127.0.0.1:6379
REDIS_CLUSTER=0                       # 1 enables the cluster client (no /db suffix on cluster URLs)
CELERY_REDIS_URL=redis://localhost:6380/0
CACHE_DEGRADE_SECONDS=2              # circuit breaker when Redis hiccups

# ====== API / app ======
JWT_SECRET=<long-random-string-see-readme>
COOKIE_SECURE=false                  # true when fronted by HTTPS
LANGGRAPH_API_URL=http://localhost:2024/
UPSTREAM_TIMEOUT=15.0
LOG_LEVEL=INFO
DEFAULT_SAMPLE_MAX_ROWS=1000
PLANNER_GRAPH_OUTPUT_DIR=/tmp/planner_graphs/

# ====== Observability (optional) ======
LANGSMITH_API_KEY=<langsmith-api-key-or-leave-blank>
LANGSMITH_PROJECT=avaloka

# ====== GCP (for GCS artifacts, MTA v2, GKE) ======
# ---------------------------------------------------------------------------
# Cloud target. Avaloka provisions clusters on four platforms; set this so the
# serving path and the provisioning path agree about where they are. If unset,
# the provider is inferred from whichever credentials are present, and an
# environment carrying two clouds' credentials is an error rather than a guess.
#   local | gcp | aws | azure
CLOUD_PROVIDER=gcp

# Container registry. Derived from the provider when unset (gcr.io/<project>,
# <account>.dkr.ecr.<region>.amazonaws.com, <name>.azurecr.io). Set it directly
# for Artifact Registry, Harbor, or a mirror.
# CONTAINER_REGISTRY=europe-docker.pkg.dev/<project>/<repo>

# --- AWS (CLOUD_PROVIDER=aws) ----------------------------------------------
# AWS_ACCOUNT_ID=<12-digit-account-id>
# AWS_REGION=us-east-1

# --- Azure (CLOUD_PROVIDER=azure) ------------------------------------------
# AZURE_SUBSCRIPTION_ID=<subscription-id>
# AZURE_RESOURCE_GROUP=<resource-group>
# AZURE_LOCATION=eastus
# AZURE_CONTAINER_REGISTRY=<acr-name>

# --- GCP (CLOUD_PROVIDER=gcp) ----------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account-key.json>
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GCP_PROJECT_ID=<gcp-project-id>
GCP_CLUSTER_NAME=<gke-cluster-name>
GCP_ZONE=us-central1-c

# ====== Object storage ======
GCS_BUCKET=<gcs-bucket-name>
GCS_INFERENCE_BUCKET=<gcs-inference-bucket-name>
GCS_INFERENCE_PREFIX=tmp-inference
AVALOKA_ASSET_BUCKET=<gs://bucket/avaloka-assets>
AVALOKA_SIGNED_URL_EXPIRY_MINUTES=15

# ====== MLflow (optional — defaults to local file storage) ======
DISABLE_MLFLOW=False
MLFLOW_BACKEND_STORE_URI=<postgresql://user:password@host:5432/mlflow_db>
MLFLOW_DEFAULT_ARTIFACT_ROOT=<gs://bucket/mlflow_runs>
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=avaloka-training

# ====== MTA v2 inference service ======
INFERENCE_MODE=local
INFERENCE_IMAGE=<registry/avaloka-inference:tag>
INFERENCE_SERVICE_DOCKER_IMAGE=<registry/inference-service-image:tag>
INFERENCE_SERVICE_GKE_CLUSTER_LOCATION=us-central1
K8S_NAMESPACE=default
K8S_SERVICE_ACCOUNT=gcs-writer         # needs GCS write permission
INFERENCE_JOB_TTL_SECONDS=600
DATASET_SIZE_BYTES_THRESHOLD_FOR_RAY_TRAINING=10485760   # 10 MB
# Optional: submit MTA training to the existing general RayCluster. Leave empty
# to retain the legacy per-run GKE RayCluster path. Never point this at the
# avaloka-inference RayService cluster. In-cluster example:
# http://avaloka-raycluster-head-svc:8265
MTA_RAY_DASHBOARD_URL=
MTA_RAY_NAMESPACE=default
MTA_RAY_TRAINING_ENTRYPOINT=python /home/ray/app/app/agents/mta_v2/training_docker_image/ray_job.py
# HMAC key for keyed PII pseudonymisation/tokenisation. GENERATED: leave empty;
# scripts/install.sh (or the first service start) generates it and saves it here.
AVALOKA_PII_KEY=

# ====== MCP server (optional) ======
MCP_SERVER_URL=http://localhost:8010
# Shared secret between the API and the MCP server; the SAME value on both. The
# onboarding API releases a database password only to a caller presenting it,
# and /admin/customers refuses everything else. GENERATED: leave empty;
# scripts/install.sh (or the first service start) generates it and saves it here.
MCP_SERVICE_TOKEN=

# ====== Credential sealing ======
# AES-GCM key for every sealed credential: database passwords in the onboarding
# registry and on their way to the MCP server, chat-typed passwords, cloud and
# MCP tokens. GENERATED: leave empty; scripts/install.sh (or the first service
# start) generates it and saves it here. A published value is replaced. Keep
# it: changing it makes every sealed credential unreadable. Same value on the
# API, MCP and edge functions. See docs/INSTALL.md, Configuration.
DB_ENCRYPTION_KEY=

# ====== Supabase (optional — sampling profile cache) ======
SUPABASE_URL=<https://your-project.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# ====== Asset registry (optional) ======
GITHUB_SYSTEM_TOKEN=<github-token>
GITHUB_JOB_REGISTRY_REPO=<org/avaloka-job-registry>

# ====== Infra defaults ======
DEFAULT_INFRA_PLATFORM=gcp             # gcp | aws | azure
ENABLE_AZURE_INFRA=0

# ====== openclaw (optional sidecar for data discovery) ======
OPENCLAW_ENABLED=0
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_TIMEOUT_S=2.0
OPENCLAW_API_KEY=<openclaw-api-key-or-leave-blank>
