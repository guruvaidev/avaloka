{
  "common": {
    "optional": {
      "route": {
        "kind": "enum",
        "values": [
          "/",
          "/analysis",
          "/configurations",
          "/dashboard",
          "/database",
          "/datasets",
          "/db-tables",
          "/logout",
          "/proanalysis",
          "/proanalysis/scheduled-analysis",
          "/reports",
          "/reports/$reportId",
          "/reports/generated",
          "/scheduled-analysis",
          "/settings",
          "/shared-report/$token",
          "/shared/$token",
          "/support",
          "/support-queries",
          "other"
        ]
      }
    },
    "required": {
      "event_id": {
        "kind": "id",
        "pattern": "^[0-9a-fA-F][0-9a-fA-F-]{15,63}$"
      },
      "event_type": {
        "kind": "enum",
        "values": [
          "auth.completed",
          "dataset.connect_completed",
          "dataset.connect_started",
          "error.shown",
          "feature.used",
          "feedback.submitted",
          "page.viewed",
          "question.completed",
          "question.submitted",
          "result.interacted",
          "session.ended",
          "session.started"
        ]
      },
      "seq": {
        "kind": "int",
        "max": 10000000,
        "min": 0
      },
      "t_ms": {
        "kind": "int",
        "max": 604800000,
        "min": 0
      }
    }
  },
  "envelope": {
    "optional": {
      "ui_version": {
        "kind": "version",
        "pattern": "^\\d{1,4}(?:\\.\\d{1,4}){0,3}(?:[-+][0-9A-Za-z.]{1,16})?$"
      }
    },
    "required": {
      "events": {
        "kind": "list"
      },
      "schema_version": {
        "kind": "version"
      },
      "session_id": {
        "kind": "id",
        "pattern": "^[0-9a-fA-F][0-9a-fA-F-]{15,63}$"
      }
    }
  },
